<Window x:Class="CalculoIRRF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calculadora IR" Height="760" Width="1120" MinHeight="620" MinWidth="940"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Grid Margin="28" Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Calculadora de IRRF" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Simule o imposto de renda, INSS e FGTS com as tabelas cadastradas." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="IRRF • Brasil" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,0" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Tema" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="ThemeComboBox" Width="128" SelectionChanged="ThemeComboBox_SelectionChanged">
                    <ComboBoxItem Content="Automático" />
                    <ComboBoxItem Content="Claro" />
                    <ComboBoxItem Content="Escuro" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.45*" /><ColumnDefinition Width="1.45*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,14,0"><TextBlock Text="Competência" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/><TextBox x:Name="CompetenciaTextBox" TextAlignment="Center" /></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,14,0"><TextBlock Text="Valor bruto" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/><TextBox x:Name="ValorBrutoTextBox" TextAlignment="Right" LostKeyboardFocus="ValorBrutoTextBox_LostKeyboardFocus" /></StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,14,0"><TextBlock Text="Base de INSS" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/><TextBox x:Name="BaseInssTextBox" TextAlignment="Right" /></StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,14,0"><TextBlock Text="Dependentes" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/><TextBox x:Name="DependentesTextBox" TextAlignment="Right" /></StackPanel>
                <Button Grid.Column="4" Style="{StaticResource PrimaryButton}" Content="Calcular" Margin="4,25,0,0" MinWidth="126" Click="Calcular_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="270" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                    <StackPanel>
                    <TextBlock Text="Tabelas e parâmetros" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Gerencie os valores de referência." Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,16" />
                        <Button Content="Tabela INSS" Click="AbrirTabelaInss_Click" Margin="0,0,0,8" />
                        <Button Content="Tabela IRRF" Click="AbrirTabelaIrrf_Click" Margin="0,0,0,8" />
                        <Button Content="Valor simplificado" Click="AbrirSimplificado_Click" Margin="0,0,0,8" />
                        <Button Content="Dedução por dependente" Click="AbrirDependente_Click" Margin="0,0,0,8" />
                        <Button Content="Desconto mínimo" Click="AbrirDescontoMinimo_Click" />
                    <Separator Margin="0,20,0,16" Background="{DynamicResource BorderBrush}" />
                    <Button x:Name="PensaoButton" Content="Calcular pensão" IsEnabled="False" Click="AbrirPensao_Click" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Resultado da simulação" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="  •  cálculo detalhado" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Bottom" /></StackPanel>
                    <RichTextBox x:Name="ResultadoRichTextBox" Grid.Row="1" Margin="0,16,0,0" IsReadOnly="True" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource ResultBackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Cascadia Mono" FontSize="13" Padding="16" VerticalScrollBarVisibility="Auto" />
                </Grid>
            </Border>
        </Grid>
        <TextBlock Grid.Row="5" Text="Calculadora de IR • Dados processados localmente" Foreground="{DynamicResource MutedTextBrush}" Margin="2,18,0,0" />
    </Grid>
</Window>
