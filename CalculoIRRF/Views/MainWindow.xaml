<Window x:Class="CalculoIRRF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:CalculoIRRF.Presentation.Behaviors"
        Title="Calculadora de Imposto" Height="863" Width="1292" MinHeight="620" MinWidth="940"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" WindowStartupLocation="CenterScreen">
	<Grid Margin="28" Background="{DynamicResource ApplicationBackgroundBrush}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="16" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="16" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<StackPanel Orientation="Horizontal">
				<Image Source="{DynamicResource BrandLogoImage}" Width="52" Height="52" Stretch="Uniform" Margin="0,0,14,0" />
				<StackPanel VerticalAlignment="Center">
					<TextBlock Text="Central de cálculos" FontSize="28" FontWeight="SemiBold" />
					<TextBlock Text="Simulações tributárias, pensão alimentícia e indenização de estabilidade." Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0" />
				</StackPanel>
			</StackPanel>
			<TextBlock Grid.Column="1" Text="Imposto • Brasil" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,0" />
			<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
				<TextBlock Text="Tema" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
				<ComboBox Width="128" ItemsSource="{Binding Temas}" SelectedItem="{Binding TemaSelecionado, Mode=TwoWay}">
					<ComboBox.ItemTemplate>
						<DataTemplate><TextBlock Text="{Binding Converter={StaticResource NomeTemaConverter}}" /></DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>
			</StackPanel>
		</Grid>

		<Border Grid.Row="2" Style="{StaticResource Card}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="1.1*" />
					<ColumnDefinition Width="1.45*" />
					<ColumnDefinition Width="1.45*" />
					<ColumnDefinition Width="1.1*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<StackPanel Margin="0,0,14,0">
					<TextBlock Text="Competência" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/>
					<TextBox Text="{Binding Competencia, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" />
				</StackPanel>
				<StackPanel Grid.Column="1" Margin="0,0,14,0">
					<TextBlock Text="Valor bruto" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/>
					<TextBox Text="{Binding ValorBruto, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" behaviors:FormatacaoNumerica.Formato="N2" />
				</StackPanel>
				<StackPanel Grid.Column="2" Margin="0,0,14,0">
					<TextBlock Text="Base de INSS" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/>
					<TextBox Text="{Binding BaseInss, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" behaviors:FormatacaoNumerica.Formato="N2" />
				</StackPanel>
				<StackPanel Grid.Column="3" Margin="0,0,14,0">
					<TextBlock Text="Dependentes" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/>
					<TextBox Text="{Binding Dependentes, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" />
				</StackPanel>
				<Button Grid.Column="4" Style="{StaticResource PrimaryButton}" Content="Calcular" Margin="4,25,0,0" MinWidth="126" Command="{Binding CalcularCommand}" />
			</Grid>
		</Border>

		<Grid Grid.Row="4">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="270" />
				<ColumnDefinition Width="16" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Border Style="{StaticResource Card}">
				<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
					<StackPanel>
						<TextBlock Text="Calculadoras" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
						<Border Padding="14,7" Background="{DynamicResource AdvantageBackgroundBrush}" BorderBrush="{DynamicResource AdvantageBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,4">
							<StackPanel>
								<TextBlock Text="Simulação tributária" FontWeight="SemiBold" Foreground="{DynamicResource AdvantageTextBrush}" />
								<TextBlock Text="IRRF, INSS e FGTS" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" />
							</StackPanel>
						</Border>
						<Button Style="{StaticResource NavigationButton}" Content="Cálculo de estabilidade" Command="{Binding AbrirEstabilidadeCommand}" />
						<Button Style="{StaticResource NavigationButton}" Content="Calcular pensão" Command="{Binding AbrirPensaoCommand}" />
						<Separator Margin="0,8,0,12" Background="{DynamicResource BorderBrush}" />
						<TextBlock Text="Tabelas e parâmetros" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
						<Button Style="{StaticResource NavigationButton}" Content="Tabela INSS" Command="{Binding AbrirTabelaInssCommand}" />
						<Button Style="{StaticResource NavigationButton}" Content="Tabela IRRF" Command="{Binding AbrirTabelaIrrfCommand}" />
						<Button Style="{StaticResource NavigationButton}" Content="Valor simplificado" Command="{Binding AbrirSimplificadoCommand}" />
						<Button Style="{StaticResource NavigationButton}" Content="Dedução por dependente" Command="{Binding AbrirDependentesCommand}" />
						<Button Style="{StaticResource NavigationButton}" Content="Desconto mínimo" Command="{Binding AbrirDescontoMinimoCommand}" />
						<Button Style="{StaticResource NavigationButton}" Content="Redução mensal do IRRF" Command="{Binding AbrirReducaoMensalIrrfCommand}" Margin="0" />
					</StackPanel>
				</ScrollViewer>
			</Border>
			<Border Grid.Column="2" Style="{StaticResource Card}">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<Grid VerticalAlignment="Center">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<TextBlock Text="Resultado da simulação" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
							<TextBlock Grid.Column="1" Text="•" Foreground="{DynamicResource MutedTextBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
							<TextBlock Grid.Column="2" Text="cálculo detalhado" Foreground="{DynamicResource MutedTextBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
						</Grid>
						<Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Gerar PDF" Command="{Binding ExportarPdfCommand}" MinWidth="112" />
					</Grid>
					<TextBlock Grid.Row="1" Style="{StaticResource EstadoVazio}" Text="Preencha competência, valor bruto, base de INSS e dependentes e selecione Calcular para ver o resumo e a memória de cálculo." />
					<ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
						<StackPanel Visibility="{Binding TemResultado, Converter={StaticResource BooleanToVisibilityConverter}}">
							<TextBlock Text="Resumo executivo" FontSize="15" FontWeight="SemiBold" />
							<ItemsControl ItemsSource="{Binding IndicadoresResumo}" Margin="0,10,0,20">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel />
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Width="205" Margin="0,0,10,10" Padding="14" Background="{DynamicResource ResultBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
											<StackPanel>
												<TextBlock Text="{Binding Rotulo}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
												<TextBlock Text="{Binding Valor}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" />
												<TextBlock Text="{Binding Complemento}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0" />
											</StackPanel>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
							<Border Padding="16" Background="{DynamicResource ResultBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,20">
								<StackPanel>
									<TextBlock Text="Comparação entre modalidades" FontSize="15" FontWeight="SemiBold" />
									<Grid Margin="0,12,0,0">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="2*" />
											<ColumnDefinition />
											<ColumnDefinition />
											<ColumnDefinition />
										</Grid.ColumnDefinitions>
										<TextBlock Text="Modalidade" FontWeight="SemiBold" />
										<TextBlock Grid.Column="1" Text="Base" FontWeight="SemiBold" />
										<TextBlock Grid.Column="2" Text="Redução" FontWeight="SemiBold" />
										<TextBlock Grid.Column="3" Text="IRRF final" FontWeight="SemiBold" />
									</Grid>
									<ItemsControl ItemsSource="{Binding ComparativoIrrf}">
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Border Margin="0,8,0,0" Padding="10,8" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8">
													<Border.Style>
														<Style TargetType="Border">
															<Style.Triggers>
																<DataTrigger Binding="{Binding EhMaisVantajosa}" Value="True">
																	<Setter Property="Background" Value="{DynamicResource AdvantageBackgroundBrush}" />
																	<Setter Property="BorderBrush" Value="{DynamicResource AdvantageBorderBrush}" />
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</Border.Style>
													<Grid>
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="2*" />
															<ColumnDefinition />
															<ColumnDefinition />
															<ColumnDefinition />
														</Grid.ColumnDefinitions>
														<StackPanel Orientation="Horizontal">
															<TextBlock Text="{Binding Modalidade}" VerticalAlignment="Center" />
															<TextBlock Text="Mais vantajoso" Visibility="{Binding EhMaisVantajosa, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="{DynamicResource AdvantageTextBrush}" FontSize="11" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
														</StackPanel>
														<TextBlock Grid.Column="1" Text="{Binding BaseCalculo}" VerticalAlignment="Center" />
														<TextBlock Grid.Column="2" Text="{Binding ReducaoMensal}" VerticalAlignment="Center" />
														<TextBlock Grid.Column="3" Text="{Binding ImpostoFinal}" FontWeight="SemiBold" VerticalAlignment="Center" />
													</Grid>
												</Border>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>
							</Border>
							<TextBlock Text="Memória de cálculo" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
							<ItemsControl ItemsSource="{Binding MemoriaIrrf}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Padding="14" Background="{DynamicResource ResultBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,12">
											<StackPanel>
												<Grid>
													<Grid.ColumnDefinitions>
														<ColumnDefinition />
														<ColumnDefinition Width="Auto" />
													</Grid.ColumnDefinitions>
													<TextBlock Text="{Binding Titulo}" FontSize="14" FontWeight="SemiBold" />
													<TextBlock Grid.Column="1" Text="{Binding Destaque}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
												</Grid>
												<ItemsControl ItemsSource="{Binding Formulas}" Margin="0,10,0,0">
													<ItemsControl.ItemTemplate>
														<DataTemplate>
															<StackPanel Margin="0,0,0,7">
																<TextBlock Text="{Binding Titulo}" FontSize="12" FontWeight="SemiBold" />
																<TextBlock Text="{Binding Formula}" FontFamily="Cascadia Mono" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
															</StackPanel>
														</DataTemplate>
													</ItemsControl.ItemTemplate>
												</ItemsControl>
											</StackPanel>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
							<ItemsControl ItemsSource="{Binding MemoriaTributaria}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Padding="16" Background="{DynamicResource ResultBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,12">
											<StackPanel>
												<Grid>
													<Grid.ColumnDefinitions>
														<ColumnDefinition />
														<ColumnDefinition Width="Auto" />
													</Grid.ColumnDefinitions>
													<TextBlock Text="{Binding Titulo}" FontSize="14" FontWeight="SemiBold" />
													<TextBlock Grid.Column="1" Text="{Binding Total, StringFormat=Total: {0}}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
												</Grid>
												<Grid Margin="0,12,0,0">
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="1.1*" />
														<ColumnDefinition />
														<ColumnDefinition />
														<ColumnDefinition />
													</Grid.ColumnDefinitions>
													<TextBlock Text="Faixa" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
													<TextBlock Grid.Column="1" Text="Base" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
													<TextBlock Grid.Column="2" Text="Alíquota" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
													<TextBlock Grid.Column="3" Text="Imposto" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
												</Grid>
												<ItemsControl ItemsSource="{Binding Linhas}">
													<ItemsControl.ItemTemplate>
														<DataTemplate>
															<Grid Margin="0,7,0,0">
																<Grid.ColumnDefinitions>
																	<ColumnDefinition Width="1.1*" />
																	<ColumnDefinition />
																	<ColumnDefinition />
																	<ColumnDefinition />
																</Grid.ColumnDefinitions>
																<TextBlock Text="{Binding Faixa}" />
																<TextBlock Grid.Column="1" Text="{Binding BaseCalculada}" />
																<TextBlock Grid.Column="2" Text="{Binding Aliquota}" />
																<TextBlock Grid.Column="3" Text="{Binding Imposto}" FontWeight="SemiBold" />
															</Grid>
														</DataTemplate>
													</ItemsControl.ItemTemplate>
												</ItemsControl>
											</StackPanel>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</ScrollViewer>
				</Grid>
			</Border>
		</Grid>
		<TextBlock Grid.Row="5" Foreground="{DynamicResource MutedTextBrush}" Margin="2,18,0,0">
			<Run Text="Calculadora de Imposto • Dados processados localmente - Desenvolvido por: Maycon Wisley" />
			<Run Text=" • " />
			<Hyperlink
				NavigateUri="https://github.com/mayconwisley/CalculoIRRF"
				RequestNavigate="Hyperlink_RequestNavigate"
				Foreground="{DynamicResource AccentBrush}">
				Projeto no Github
			</Hyperlink>
		</TextBlock>
	</Grid>
</Window>
