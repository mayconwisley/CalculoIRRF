<Window x:Class="CalculoIRRF.Views.PensaoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:CalculoIRRF.Presentation.Behaviors"
        Title="Cálculo de pensão alimentícia" Height="760" Width="1020" MinHeight="600" MinWidth="820"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" WindowStartupLocation="CenterOwner">
    <Grid Margin="28" Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Cálculo de pensão alimentícia" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Comparação entre os modelos normal e simplificado." Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0" />
        </StackPanel>
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0"><TextBlock Text="Rendimentos" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/><TextBox Text="{Binding ValorBruto, Mode=OneWay}" IsReadOnly="True" TextAlignment="Right" /></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Percentual da pensão" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/><TextBox Text="{Binding Percentual, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" behaviors:FormatacaoNumerica.Formato="N2" /></StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="Outros descontos" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/><TextBox Text="{Binding OutrosDescontos, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" behaviors:FormatacaoNumerica.Formato="N2" /></StackPanel>
                <Button Grid.Column="3" Content="Resumo" Margin="0,25,8,0" Command="{Binding CalcularResumoCommand}" />
                <Button Grid.Column="4" Style="{StaticResource PrimaryButton}" Content="Detalhar" Margin="0,25,0,0" Command="{Binding CalcularDetalheCommand}" />
            </Grid>
        </Border>
        <Border Grid.Row="4" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Resultado da simulação" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Gerar PDF" Command="{Binding ExportarPdfCommand}" MinWidth="112" />
                </Grid>
                <TextBlock Grid.Row="1" Style="{StaticResource EstadoVazio}" Text="Informe o percentual da pensão e selecione Resumo para o comparativo ou Detalhar para a memória de cálculo por iteração." />
                <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Visibility="{Binding TemResultado, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Resumo executivo" FontSize="15" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding IndicadoresResumo}" Margin="0,10,0,20">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><Border Width="210" Margin="0,0,10,10" Padding="14" Background="{DynamicResource ResultBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"><StackPanel><TextBlock Text="{Binding Rotulo}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" /><TextBlock Text="{Binding Valor}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" /><TextBlock Text="{Binding Complemento}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Padding="16" Background="{DynamicResource ResultBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,20"><StackPanel>
                            <TextBlock Text="Comparação entre modalidades" FontSize="15" FontWeight="SemiBold" />
                            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="Modalidade" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="IRRF final" FontWeight="SemiBold" /><TextBlock Grid.Column="2" Text="Pensão" FontWeight="SemiBold" /><TextBlock Grid.Column="3" Text="Total" FontWeight="SemiBold" /></Grid>
                            <ItemsControl ItemsSource="{Binding ComparativoPensao}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="{Binding Modalidade}" /><TextBlock Grid.Column="1" Text="{Binding IrrfFinal}" /><TextBlock Grid.Column="2" Text="{Binding Pensao}" /><TextBlock Grid.Column="3" Text="{Binding Total}" FontWeight="SemiBold" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel></Border>
                        <TextBlock Text="Memória de cálculo" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding MensagemMemoria}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,10" />
                        <ItemsControl ItemsSource="{Binding MemoriaPensao}" Visibility="{Binding TemMemoria, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate><DataTemplate><Border Padding="16" Background="{DynamicResource ResultBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,12"><StackPanel>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Titulo}" FontSize="14" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding Destaque}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" /></Grid>
                                <ItemsControl ItemsSource="{Binding Iteracoes}" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" /><ItemsControl ItemsSource="{Binding Formulas}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,7"><TextBlock Text="{Binding Titulo}" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{Binding Formula}" FontFamily="Cascadia Mono" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
