<Window x:Class="CalculoIRRF.Views.TabelaManutencaoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:CalculoIRRF.Presentation.Behaviors"
        Title="{Binding Titulo}" Height="720" Width="1060" MinHeight="600" MinWidth="900"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <behaviors:BindingProxy x:Key="Proxy" Data="{Binding}" />
    </Window.Resources>
    <Grid Margin="32" Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Titulo}" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Descricao}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource ButtonBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="12,6" VerticalAlignment="Center" Visibility="{Binding ExibeAtualizacaoOnline, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Fonte oficial disponível" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
            </Border>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <!-- Só os campos usados pela tabela aberta; UniformGrid redistribui a largura quando algum é ocultado. -->
                <UniformGrid Rows="1">
                    <StackPanel Margin="0,0,12,0"><TextBlock Text="Competência" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/><TextBox Text="{Binding Competencia, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" ToolTip="Informe mês e ano: MM/AAAA"/></StackPanel>
                    <StackPanel Margin="0,0,12,0" Visibility="{Binding ExibeFaixa, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Faixa" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/><TextBox Text="{Binding Faixa, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right"/></StackPanel>
                    <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding LabelValor}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/><TextBox Text="{Binding Valor, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" behaviors:FormatacaoNumerica.Formato="N2"/></StackPanel>
                    <StackPanel Margin="0,0,12,0" Visibility="{Binding ExibeFaixa, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding LabelAliquota}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/><TextBox Text="{Binding Aliquota, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" behaviors:FormatacaoNumerica.Formato="#,##0.00####"/></StackPanel>
                    <StackPanel Margin="0,0,12,0" Visibility="{Binding ExibeDeducao, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding LabelDeducao}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/><TextBox Text="{Binding Deducao, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" behaviors:FormatacaoNumerica.Formato="N2"/></StackPanel>
                </UniformGrid>
                <Button Grid.Column="1" Content="{Binding TextoSalvar}" Command="{Binding SalvarCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" MinWidth="142"/>
            </Grid>
        </Border>
        <Border Grid.Row="4" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding TituloLista}" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="Selecione uma linha para editar ou excluir, ou use Novo registro para incluir." Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Novo registro" Command="{Binding NovoCommand}" Margin="0,0,8,0"/>
                        <Button Content="Recarregar lista" Command="{Binding CarregarCommand}" Margin="0,0,8,0"/>
                        <Button Content="Excluir selecionado" Command="{Binding ExcluirCommand}"/>
                    </StackPanel>
                </Grid>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Registros}" SelectedItem="{Binding Selecionado}" AutoGenerateColumns="False" BorderBrush="{DynamicResource BorderBrush}" SelectionMode="Single" HeadersVisibility="Column" AlternationCount="2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Competência" Binding="{Binding Competencia, StringFormat={}{0:MM/yyyy}}" Width="130"/>
                        <DataGridTextColumn Header="Faixa" Binding="{Binding Faixa}" Width="80" Visibility="{Binding Data.ExibeFaixa, Source={StaticResource Proxy}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <DataGridTextColumn Header="{Binding Data.LabelValor, Source={StaticResource Proxy}}" Binding="{Binding Valor, StringFormat={}{0:N2}}" Width="*" HeaderStyle="{StaticResource CabecalhoNumerico}" ElementStyle="{StaticResource CelulaNumerica}"/>
                        <DataGridTextColumn Header="{Binding Data.LabelAliquota, Source={StaticResource Proxy}}" Binding="{Binding Aliquota, StringFormat={}{0:#,##0.00####}}" Width="*" HeaderStyle="{StaticResource CabecalhoNumerico}" ElementStyle="{StaticResource CelulaNumerica}" Visibility="{Binding Data.ExibeFaixa, Source={StaticResource Proxy}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <DataGridTextColumn Header="{Binding Data.LabelDeducao, Source={StaticResource Proxy}}" Binding="{Binding Deducao, StringFormat={}{0:N2}}" Width="*" HeaderStyle="{StaticResource CabecalhoNumerico}" ElementStyle="{StaticResource CelulaNumerica}" Visibility="{Binding Data.ExibeDeducao, Source={StaticResource Proxy}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="3" Margin="0,18,0,0" Visibility="{Binding ExibeAtualizacaoOnline, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusAtualizacao}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
                        <Button Style="{StaticResource LinkButton}" Content="{Binding TextoLinkFonteOficial}" Command="{Binding AbrirFonteOficialCommand}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Atualizar pela internet" Command="{Binding AtualizarDaReceitaCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" MinWidth="202"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
