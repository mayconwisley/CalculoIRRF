<Window x:Class="CalculoIRRF.Views.TabelaManutencaoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titulo}" Height="720" Width="1060" MinHeight="600" MinWidth="900"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Grid Margin="32" Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Titulo}" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Descricao}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource ButtonBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="12,6" VerticalAlignment="Center" Visibility="{Binding ExibeAtualizacaoOnline, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Fonte oficial disponível" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
            </Border>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.75*"/><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0"><TextBlock Text="Competência" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/><TextBox Text="{Binding Competencia, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" ToolTip="Informe mês e ano: MM/AAAA"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Faixa" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/><TextBox Text="{Binding Faixa, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right"/></StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="{Binding LabelValor}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/><TextBox Text="{Binding Valor, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right"/></StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,12,0"><TextBlock Text="{Binding LabelAliquota}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/><TextBox Text="{Binding Aliquota, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right"/></StackPanel>
                <StackPanel Grid.Column="4" Margin="0,0,12,0"><TextBlock Text="{Binding LabelDeducao}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/><TextBox Text="{Binding Deducao, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right"/></StackPanel>
                <Button Grid.Column="5" Content="Salvar alteração" Command="{Binding SalvarCommand}" Style="{StaticResource PrimaryButton}" Margin="0,25,0,0" MinWidth="132"/>
            </Grid>
        </Border>
        <Border Grid.Row="4" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Faixas cadastradas" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="Selecione uma linha para editar ou excluir." Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Recarregar lista" Command="{Binding CarregarCommand}" Margin="0,0,8,0"/>
                        <Button Content="Excluir selecionado" Command="{Binding ExcluirCommand}"/>
                    </StackPanel>
                </Grid>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Registros}" SelectedItem="{Binding Selecionado}" AutoGenerateColumns="False" BorderBrush="{DynamicResource BorderBrush}" SelectionMode="Single" HeadersVisibility="Column" AlternationCount="2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Competência" Binding="{Binding Competencia, StringFormat={}{0:MM/yyyy}}" Width="140"/>
                        <DataGridTextColumn Header="Faixa" Binding="{Binding Faixa}" Width="90"/>
                        <DataGridTextColumn Header="Limite / valor (R$)" Binding="{Binding Valor, StringFormat={}{0:N2}}" Width="*"/>
                        <DataGridTextColumn Header="Alíquota / multiplicador" Binding="{Binding Aliquota, StringFormat={}{0:N6}}" Width="180"/>
                        <DataGridTextColumn Header="Dedução / valor-base (R$)" Binding="{Binding Deducao, StringFormat={}{0:N2}}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="3" Margin="0,18,0,0" Visibility="{Binding ExibeAtualizacaoOnline, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusAtualizacao}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
                        <Button Content="Abrir página de tabelas da Receita Federal ↗" Command="{Binding AbrirFonteOficialCommand}" Padding="0,6" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Atualizar da Receita" Command="{Binding AtualizarDaReceitaCommand}" Style="{StaticResource PrimaryButton}" MinWidth="184"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
